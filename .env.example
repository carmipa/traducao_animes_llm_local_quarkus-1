# Copie para `.env` e ajuste. O `.env` NÃO vai para o git nem para a imagem.
#
#   cp .env.example .env

# Raiz do acervo de animes no HOST. Vira /acervo dentro do contêiner.
# Windows: use barra normal, não a invertida.
KRONOS_ACERVO=C:/animes

# Onde o LM Studio atende no HOST. host.docker.internal é o host visto de
# dentro do contêiner — 127.0.0.1 aqui apontaria para o próprio contêiner.
KRONOS_LLM_BASE_URL=http://host.docker.internal:1234/v1
